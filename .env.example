POSTGRES_DB=funerariadb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SERVER_PORT=8081

JWT_TOKEN_SECRET=local-dev-jwt-secret-change-me
SECURITY_PASSWORD_PEPPER=local-dev-pepper
SECURITY_REQUEST_FINGERPRINT_SECRET=local-dev-fingerprint-secret

APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMAIL=admin@funeraria.local
APP_BOOTSTRAP_ADMIN_PASSWORD=Admin123!
APP_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
APP_BOOTSTRAP_ADMIN_LAST_NAME=Funeraria

APP_STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8081/files/
APP_STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_ROOT_PATH=/data/storage

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager email delivery. Defaults are dummies so the observability profile starts cleanly
# without exposing real credentials; SMTP send attempts will fail at auth/connection level and
# surface as warnings until real Gmail values are provided. Gmail requires 2FA on the sending
# account plus a generated App Password (Google Account → Security → App passwords). The
# 'From' address must match the authenticated user; routing to a different recipient is fine.
ALERTMANAGER_SMTP_HOST=smtp.gmail.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=alerts@example.com
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_EMAIL_TO=alerts@example.com
# Dead-man's switch: ping URL of an external heartbeat check, e.g. https://hc-ping.com/<uuid>
# (healthchecks.io, free tier: period 5 minutes, grace 10 minutes). Alertmanager pings it every
# 5 minutes through the always-firing Watchdog alert; the service emails you when pings stop,
# which catches a dead Prometheus, Alertmanager or host. Keep it secret. Empty = disabled.
ALERTMANAGER_WATCHDOG_URL=

# Distributed tracing (ADR-0018). Export is ON by default in compose: spans go to the OTel
# Collector (base stack) and on to Tempo when the observability profile is running. Set to false
# to switch export off; the traceId still flows into MDC and response headers. The endpoint
# defaults to the compose collector; never set it to an empty value (Spring Boot 4 fails at startup).
# MANAGEMENT_TRACING_EXPORT_ENABLED=false
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_GRPC_PORT=4317
TEMPO_HTTP_PORT=3200
